<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Laporan;
use App\Models\LaporanFile;
use App\Models\LaporanLog;
use App\Models\User;
use Illuminate\Http\Request;

class LaporanController extends Controller
{
    // ======================================================
    // KONFIGURASI
    // ======================================================

    const MAX_FOTO = 5;

    // ======================================================
    // GET /api/laporans
    // Semua laporan
    // ======================================================

    public function index()
    {
        $laporans = Laporan::with([
            'user',
            'kategoriRelasi',
            'petugas',
            'files',
            'logs.user',
        ])
            ->latest()
            ->get();

        return response()->json($laporans);
    }

    public function tugasSaya(Request $request)
    {
        $laporans = Laporan::with([
            'user',
            'kategoriRelasi',
            'petugas',
            'files',
            'logs.user',
        ])
            ->where('petugas_id', $request->user()->id)
            ->latest()
            ->get();

        return response()->json($laporans);
    }

    // ======================================================
    // POST /api/laporans
    // Warga membuat laporan
    // ======================================================

    public function store(Request $request)
    {
        $validated = $request->validate([
            'judul' => 'required|string|max:255',
            'deskripsi' => 'required|string',

            'kategori_id' => [
                'required',
                'exists:kategoris,id',
            ],

            'lokasi' => 'nullable|string',
            'latitude' => 'nullable|numeric',
            'longitude' => 'nullable|numeric',

            // Foto lama / single
            'foto' => [
                'nullable',
                'image',
                'mimes:jpeg,png,jpg,webp',
                'max:2048',
            ],

            // Foto banyak
            'fotos' => 'nullable|array|max:' . self::MAX_FOTO,

            'fotos.*' => [
                'image',
                'mimes:jpeg,png,jpg,webp',
                'max:2048',
            ],
        ]);

        $validated['user_id'] = $request->user()->id;
        $validated['status'] = 'baru';

        // ==================================================
        // KUMPULKAN FOTO
        // ==================================================

        $fotoFiles = [];

        if ($request->hasFile('fotos')) {
            $fotoFiles = $request->file('fotos');
        }

        // Support foto single lama
        if ($request->hasFile('foto')) {
            array_unshift(
                $fotoFiles,
                $request->file('foto')
            );
        }

        if (count($fotoFiles) > self::MAX_FOTO) {
            return response()->json([
                'message' =>
                    'Maksimal ' .
                    self::MAX_FOTO .
                    ' foto per laporan.',
            ], 422);
        }

        // ==================================================
        // SIMPAN FOTO PERTAMA KE KOLOM FOTO LAMA
        // ==================================================

        if (count($fotoFiles) > 0) {
            $validated['foto'] = $fotoFiles[0]
                ->store('laporan-foto', 'public');
        }

        unset($validated['fotos']);

        // ==================================================
        // BUAT LAPORAN
        // ==================================================

        $laporan = Laporan::create($validated);

        // ==================================================
        // SIMPAN SEMUA FOTO KE LAPORAN_FILES
        // ==================================================

        foreach ($fotoFiles as $index => $file) {

            // Foto pertama sudah disimpan di atas
            $path = $index === 0
                ? $validated['foto']
                : $file->store(
                    'laporan-foto',
                    'public'
                );

            LaporanFile::create([
                'laporan_id' => $laporan->id,
                'path' => $path,
                'tipe' => 'sebelum',
                'urutan' => $index,
            ]);
        }

        // ==================================================
        // CATAT LOG
        // ==================================================

        $this->catatLog(
            $laporan,
            'dibuat',
            'Laporan dibuat oleh ' .
                $request->user()->name,
            $request->user()->id
        );

        return response()->json([
            'message' => 'Laporan berhasil dibuat',

            'data' => $laporan->load([
                'user',
                'kategoriRelasi',
                'petugas',
                'files',
                'logs.user',
            ]),
        ], 201);
    }

    // ======================================================
    // GET /api/laporans/tugas-saya
    // Laporan yang ditugaskan ke petugas login
    //
    // PENTING:
    // Route ini harus berada sebelum
    // /laporans/{laporan} di routes/api.php
    // ======================================================

    public function tugasSaya(Request $request)
    {
        $laporans = Laporan::with([
            'user',
            'kategoriRelasi',
            'petugas',
            'files',
            'logs.user',
        ])
            ->where(
                'petugas_id',
                $request->user()->id
            )
            ->latest()
            ->get();

        return response()->json($laporans);
    }

    // ======================================================
    // GET /api/laporans/{laporan}
    // Detail laporan
    // ======================================================

    public function show(Laporan $laporan)
    {
        $laporan->load([
            'user',
            'kategoriRelasi',
            'petugas',
            'tanggapans.user',
            'files',
            'logs.user',
        ]);

        return response()->json([
            'data' => $laporan,
        ]);
    }

    // ======================================================
    // PUT/PATCH /api/laporans/{laporan}
    // Update laporan
    // ======================================================

    public function update(
        Request $request,
        Laporan $laporan
    ) {
        $validated = $request->validate([
            'judul' => 'sometimes|string|max:255',

            'deskripsi' => 'sometimes|string',

            'kategori_id' => [
                'sometimes',
                'exists:kategoris,id',
            ],

            'lokasi' => 'nullable|string',
            'latitude' => 'nullable|numeric',
            'longitude' => 'nullable|numeric',

            'status' => [
                'sometimes',
                'in:baru,diproses,selesai,ditolak',
            ],

            'alasan_ditolak' => [
                'nullable',
                'string',
                'max:1000',
                'required_if:status,ditolak',
            ],

            'foto' => [
                'nullable',
                'image',
                'mimes:jpeg,png,jpg,webp',
                'max:2048',
            ],

            'fotos' => 'nullable|array',

            'fotos.*' => [
                'image',
                'mimes:jpeg,png,jpg,webp',
                'max:2048',
            ],

            'hapus_file_ids' => 'nullable|array',

            'hapus_file_ids.*' => [
                'integer',
                'exists:laporan_files,id',
            ],
        ]);

        $statusSebelum = $laporan->status;

        // ==================================================
        // HAPUS FILE
        // ==================================================

        if (!empty($validated['hapus_file_ids'])) {

            $files = $laporan
                ->files()
                ->whereIn(
                    'id',
                    $validated['hapus_file_ids']
                )
                ->get();

            foreach ($files as $file) {
                $file->delete();
            }
        }

        unset($validated['hapus_file_ids']);

        // ==================================================
        // FOTO BARU
        // ==================================================

        $fotoFiles = [];

        if ($request->hasFile('fotos')) {
            $fotoFiles = $request->file('fotos');
        }

        if ($request->hasFile('foto')) {
            array_unshift(
                $fotoFiles,
                $request->file('foto')
            );
        }

        $totalSetelah =
            $laporan->files()->count() +
            count($fotoFiles);

        if ($totalSetelah > self::MAX_FOTO) {
            return response()->json([
                'message' =>
                    'Maksimal ' .
                    self::MAX_FOTO .
                    ' foto per laporan.',
            ], 422);
        }

        if (count($fotoFiles) > 0) {

            $urutanAwal =
                $laporan->files()->max('urutan');

            $urutanAwal =
                $urutanAwal === null
                    ? 0
                    : $urutanAwal + 1;

            $fotoLegacyDisimpan = false;

            foreach (
                $fotoFiles as $index => $file
            ) {

                $path = $file->store(
                    'laporan-foto',
                    'public'
                );

                // Jika kolom foto lama masih kosong,
                // gunakan foto pertama sebagai foto legacy.
                if (
                    !$laporan->foto &&
                    !$fotoLegacyDisimpan
                ) {
                    $validated['foto'] = $path;
                    $fotoLegacyDisimpan = true;
                }

                LaporanFile::create([
                    'laporan_id' => $laporan->id,
                    'path' => $path,
                    'tipe' => 'sebelum',
                    'urutan' =>
                        $urutanAwal + $index,
                ]);
            }
        }

        unset($validated['fotos']);

        // ==================================================
        // UPDATE LAPORAN
        // ==================================================

        $laporan->update($validated);

        // ==================================================
        // LOG PERUBAHAN STATUS
        // ==================================================

        if (
            isset($validated['status']) &&
            $validated['status'] !== $statusSebelum
        ) {

            $keterangan =
                'Status diubah dari ' .
                $statusSebelum .
                ' menjadi ' .
                $validated['status'];

            if (
                $validated['status'] === 'ditolak' &&
                !empty($validated['alasan_ditolak'])
            ) {
                $keterangan .=
                    '. Alasan: ' .
                    $validated['alasan_ditolak'];
            }

            $this->catatLog(
                $laporan,
                'status_berubah',
                $keterangan,
                $request->user()->id
            );
        }

        return response()->json([
            'message' =>
                'Laporan berhasil diperbarui',

            'data' => $laporan->load([
                'user',
                'kategoriRelasi',
                'petugas',
                'files',
                'logs.user',
            ]),
        ]);
    }

    // ======================================================
    // PUT /api/laporans/{laporan}/assign
    // Admin assign petugas
    // ======================================================

    public function assignPetugas(
        Request $request,
        Laporan $laporan
    ) {
        $validated = $request->validate([
            'petugas_id' => [
                'required',
                'exists:users,id',
            ],
        ]);

        $petugas = User::find(
            $validated['petugas_id']
        );

        if ($petugas->role !== 'petugas') {
            return response()->json([
                'message' =>
                    'User yang dipilih bukan petugas.',
            ], 422);
        }

        $laporan->update([
            'petugas_id' => $petugas->id,
        ]);

        // ==================================================
        // LOG ASSIGN
        // ==================================================

        $this->catatLog(
            $laporan,
            'diassign',
            'Laporan ditugaskan kepada ' .
                $petugas->name,
            $request->user()->id
        );

        return response()->json([
            'message' =>
                'Laporan berhasil ditugaskan kepada ' .
                $petugas->name,

            'data' => $laporan->load([
                'user',
                'kategoriRelasi',
                'petugas',
                'files',
                'logs.user',
            ]),
        ]);
    }

    // ======================================================
    // PUT /api/laporans/{laporan}/progress
    // Petugas update progress
    // ======================================================

    public function updateProgress(
        Request $request,
        Laporan $laporan
    ) {
        // Pastikan laporan memang milik petugas
        // yang sedang login.
        if (
            $laporan->petugas_id !==
            $request->user()->id
        ) {
            return response()->json([
                'message' =>
                    'Laporan ini tidak ditugaskan kepada kamu.',
            ], 403);
        }

        $validated = $request->validate([
            'status' => [
                'required',
                'in:diproses,selesai,ditolak',
            ],

            'catatan' =>
                'nullable|string|max:1000',

            'alasan_ditolak' => [
                'nullable',
                'string',
                'max:1000',
                'required_if:status,ditolak',
            ],

            'fotos' =>
                'nullable|array|max:' . self::MAX_FOTO,

            'fotos.*' => [
                'image',
                'mimes:jpeg,png,jpg,webp',
                'max:2048',
            ],
        ]);

        // ==================================================
        // UPDATE STATUS
        // ==================================================

        $laporan->update([
            'status' =>
                $validated['status'],

            'alasan_ditolak' =>
                $validated['status'] === 'ditolak'
                    ? ($validated['alasan_ditolak'] ?? null)
                    : null,
        ]);

        // ==================================================
        // LOG STATUS
        // ==================================================

        $keterangan =
            'Status diubah menjadi ' .
            $validated['status'] .
            ' oleh ' .
            $request->user()->name;

        if (
            $validated['status'] === 'ditolak' &&
            !empty($validated['alasan_ditolak'])
        ) {

            $keterangan .=
                '. Alasan: ' .
                $validated['alasan_ditolak'];
        }

        if (
            $validated['status'] !== 'ditolak' &&
            !empty($validated['catatan'])
        ) {

            $keterangan .=
                '. Catatan: ' .
                $validated['catatan'];
        }

        $this->catatLog(
            $laporan,
            'status_berubah',
            $keterangan,
            $request->user()->id
        );

        // ==================================================
        // FOTO SESUDAH
        // ==================================================

        $fotoFiles = [];

        if ($request->hasFile('fotos')) {
            $fotoFiles =
                $request->file('fotos');
        }

        if (count($fotoFiles) > 0) {

            $urutanAwal =
                $laporan
                    ->files()
                    ->where(
                        'tipe',
                        'sesudah'
                    )
                    ->max('urutan');

            $urutanAwal =
                $urutanAwal === null
                    ? 0
                    : $urutanAwal + 1;

            foreach (
                $fotoFiles as $index => $file
            ) {

                $path = $file->store(
                    'laporan-foto',
                    'public'
                );

                LaporanFile::create([
                    'laporan_id' => $laporan->id,
                    'path' => $path,
                    'tipe' => 'sesudah',
                    'urutan' =>
                        $urutanAwal + $index,
                ]);
            }

            // ==================================================
            // LOG FOTO
            // ==================================================

            $this->catatLog(
                $laporan,
                'foto_ditambahkan',
                count($fotoFiles) .
                    ' foto bukti pekerjaan ditambahkan oleh ' .
                    $request->user()->name,
                $request->user()->id
            );
        }

        return response()->json([
            'message' =>
                'Progress laporan berhasil diperbarui',

            'data' => $laporan->load([
                'user',
                'kategoriRelasi',
                'petugas',
                'files',
                'logs.user',
            ]),
        ]);
    }

    // ======================================================
    // DELETE /api/laporans/{laporan}/files/{file}
    // Hapus foto laporan
    // ======================================================

    public function destroyFile(
        Laporan $laporan,
        LaporanFile $file
    ) {
        if (
            $file->laporan_id !==
            $laporan->id
        ) {
            return response()->json([
                'message' =>
                    'File tidak ditemukan pada laporan ini.',
            ], 404);
        }

        $file->delete();

        return response()->json([
            'message' =>
                'Foto berhasil dihapus',

            'data' =>
                $laporan->load('files'),
        ]);
    }

    // ======================================================
    // DELETE /api/laporans/{laporan}
    // ======================================================

    public function destroy(
        Laporan $laporan
    ) {
        $laporan->delete();

        return response()->json([
            'message' =>
                'Laporan berhasil dihapus',
        ]);
    }

    // ======================================================
    // CATAT LOG
    // ======================================================

    private function catatLog(
        Laporan $laporan,
        string $tipe,
        ?string $keterangan = null,
        ?int $userId = null
    ): void {
        LaporanLog::create([
            'laporan_id' => $laporan->id,
            'tipe' => $tipe,
            'keterangan' => $keterangan,
            'user_id' => $userId,
        ]);
    }
}
